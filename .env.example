# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the service listens on
PORT=3000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL connection string (used by Prisma)
DATABASE_URL=postgresql://vehicle:vehicle@localhost:5432/vehicle_data?schema=public

# NHTSA vPIC API base URL
NHTSA_API_BASE_URL=https://vpic.nhtsa.dot.gov/api

# Timeout for each outbound HTTP request (ms)
NHTSA_REQUEST_TIMEOUT_MS=15000

# Max retry attempts for failed outbound HTTP requests
NHTSA_MAX_RETRIES=3

# How many vehicle-type requests run in parallel during ingestion
INGESTION_CONCURRENCY=10

# Limit the number of makes ingested (0 = ingest all ~12k makes).
# Useful for local development / demos to avoid thousands of API calls.
INGESTION_MAKE_LIMIT=0

# How many records are persisted per database batch
INGESTION_BATCH_SIZE=500

# Enable scheduled (cron) ingestion
INGESTION_CRON_ENABLED=false

# Cron expression for scheduled ingestion (default: every day at 03:00)
INGESTION_CRON_EXPRESSION=0 3 * * *
